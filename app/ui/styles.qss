/* Prandia, global stylesheet.
 * Discreet palette, comfortable spacing, focus rings consistent across widgets. */

QWidget {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 10pt;
    color: #1f2937;
    background-color: #fafaf7;
}

QMainWindow {
    background-color: #f3f3ee;
}

QTabWidget::pane {
    border: 1px solid #d6d3c4;
    background: #fafaf7;
}

QTabBar::tab {
    padding: 8px 18px;
    background: #ece9dc;
    border: 1px solid #d6d3c4;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #fafaf7;
    font-weight: 600;
    color: #1b5e20;
}

QGroupBox {
    border: 1px solid #d6d3c4;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 8px;
    background: #fafaf7;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #4b5563;
    font-weight: 600;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #ffffff;
    border: 1px solid #cdcab9;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #cfe8d3;
    selection-color: #1f2937;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #2e7d32;
}

/* No sub-control rules for spinboxes — every QSpinBox/QDoubleSpinBox sets
 * setButtonSymbols(NoButtons) so the up/down arrows are not displayed at all.
 * Values are typed directly. */

/* Unit cell appended to a fixed-unit numeric field (see _FixedUnitField in
 * ingredients_tab.py): visually a small read-only "g/100g" or "kcal/100g" tag
 * sitting flush to the right of the spinbox. */
QLabel#unitCell {
    background: #ece9dc;
    border: 1px solid #cdcab9;
    border-left: none;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    color: #4b5563;
    padding: 4px 10px;
    min-width: 60px;
    font-size: 9pt;
}

QPushButton {
    background-color: #2e7d32;
    color: #ffffff;
    border: 1px solid #1b5e20;
    border-radius: 4px;
    padding: 5px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #43a047;
}

QPushButton:pressed {
    background-color: #1b5e20;
}

QPushButton:disabled {
    background-color: #c4c1b1;
    color: #6b7280;
    border-color: #aaa896;
}

QListWidget, QTableWidget {
    background: #ffffff;
    alternate-background-color: #f5f3ea;
    border: 1px solid #d6d3c4;
    border-radius: 4px;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #cfe8d3;
    color: #1f2937;
}

QHeaderView::section {
    background-color: #ece9dc;
    padding: 4px 8px;
    border: 0;
    border-right: 1px solid #d6d3c4;
    border-bottom: 1px solid #d6d3c4;
    font-weight: 600;
}

QFrame#ingredientSuggestionPopup {
    background: #ffffff;
    border: 1px solid #2e7d32;
    border-radius: 4px;
}

QStatusBar {
    background: #ece9dc;
    border-top: 1px solid #d6d3c4;
}

QSplitter::handle {
    background: #d6d3c4;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}
