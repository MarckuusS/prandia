{
  "name": "@prandia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "// build": "Deux etapes : le site, puis l'API bundlee en _worker.js dans la meme sortie. Pages execute ce fichier devant chaque requete.",
    "build": "vite build && npm run build:api",
    "build:api": "esbuild ../worker/src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --main-fields=module,main --outfile=dist/_worker.js --minify",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@prandia/shared": "*",
    "@tanstack/react-query": "^5.64.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
